# ---------------------------------------------------------------------------
# Godot 4.x
# ---------------------------------------------------------------------------

# Cache du moteur : reconstruit intégralement à la prochaine ouverture.
.godot/

# Cache d'import Godot 3.x, présent si un asset transite par un vieil outil.
.import/

# Modèle Android exporté par le moteur, régénérable depuis l'éditeur.
/android/

# Traductions compilées depuis les CSV.
*.translation

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------

# export_presets.cfg contient les chemins locaux et, en production, les
# identifiants de signature et la clé Steam. Il ne doit jamais partir dans
# l'historique. Sa recréation sera documentée dans CLAUDE.md.
export_presets.cfg
export.cfg

# Binaires produits par les exports.
/build/
/export/

# ---------------------------------------------------------------------------
# Dépendances tierces
# ---------------------------------------------------------------------------

# gdUnit4 est installé par tools/test.ps1 à une version épinglée. Le dépôt ne
# porte pas 4 Mo de code tiers ; la version reste reproductible.
/addons/

# ---------------------------------------------------------------------------
# Outils du projet
# ---------------------------------------------------------------------------

# Rapports de la suite gdUnit4 (tools/test.ps1).
/reports/

# Journaux des instances lancées par tools/netharness.ps1.
/logs/

# Surcharges locales de configuration Claude Code : propres à la machine.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Système et éditeurs
# ---------------------------------------------------------------------------

Thumbs.db
desktop.ini
.DS_Store
.vs/
.vscode/
.idea/
*.tmp
*.swp

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------

# Arbres de travail crees par les agents parallelles. Ce sont des depots git
# a part entiere : les versionner ici en ferait des sous-modules fantomes.
.claude/worktrees/

# gdUnit4 est récupéré par outils/tester.sh à une version épinglée : le dépôt
# ne porte pas 4 Mo de code tiers.
/addons/
/reports/

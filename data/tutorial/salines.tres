[sub_resource type="Resource" id="Resource_l8l1v"]
script = ExtResource("2_emq2c")
id = &"regarder"
position = Vector2(0, -29)
radius = 5.2
line = "Bouge la souris."
hint = "La caméra ne sert pas à voir : elle décide où tu frappes."
condition = 1

[sub_resource type="Resource" id="Resource_xprqm"]
script = ExtResource("2_emq2c")
id = &"avancer"
position = Vector2(0, -25)
radius = 4.6
line = "ZQSD pour marcher."
hint = "Le déplacement suit la caméra, jamais le personnage."
condition = 2

[sub_resource type="Resource" id="Resource_bdgjb"]
script = ExtResource("2_emq2c")
id = &"rouler"
position = Vector2(0, -16.5)
radius = 4.2
line = "Espace pour rouler."
hint = "Tu es invulnérable PENDANT la roulade. Pas avant, pas après."
condition = 3

[sub_resource type="Resource" id="Resource_15yh0"]
script = ExtResource("2_emq2c")
id = &"frapper"
position = Vector2(3, -20.5)
radius = 4.0
line = "Ce mannequin ne rend pas les coups."
hint = "Clic gauche. C'est le seul adversaire du jeu qui te laissera recommencer."
condition = 4

[sub_resource type="Resource" id="Resource_kdjja"]
script = ExtResource("2_emq2c")
id = &"jaune"
position = Vector2(6, -23.5)
radius = 4.0
line = "Ton arme vire au JAUNE au moment où elle blesse."
hint = "Celle des ennemis aussi. C'est le seul repère de rythme du jeu — apprends-le ici, où ça ne coûte rien."
condition = 6
tone = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_j8mlp"]
script = ExtResource("2_emq2c")
id = &"seconde"
position = Vector2(0, -8)
radius = 4.2
line = "Clic droit : ta seconde arme."
hint = "Chaque classe a la sienne. Elle coûte plus d'endurance."
condition = 5

[sub_resource type="Resource" id="Resource_f25xp"]
script = ExtResource("2_emq2c")
id = &"feu"
position = Vector2(0, 0.5)
radius = 4.2
line = "Entre dans l'anneau et appuie sur E."
hint = "Le feu te rend ta vie — et replace tous les gobelins. C'est le marché."
condition = 7
tone = Color(0.42, 0.74, 1, 1)

[sub_resource type="Resource" id="Resource_bepjp"]
script = ExtResource("2_emq2c")
id = &"couloir"
position = Vector2(0, 12.4)
radius = 4.4
line = "Au-delà, plus rien ne pardonne."
hint = "Ils sont six sur les salines. Attire-les un par un ; à deux, tu meurs."
read_seconds = 5.0
tone = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_8t374"]
script = ExtResource("2_emq2c")
id = &"verrou"
position = Vector2(0, 15.6)
radius = 3.8
line = "Tab, ou le bouton du milieu : accroche-toi à lui."
hint = "Verrouillé, tu lui restes de face. Tu recules, tu tournes autour, tu ne le perds plus."
read_seconds = 5.5
tone = Color(0.42, 0.74, 1, 1)

[sub_resource type="Resource" id="Resource_jpdsi"]
script = ExtResource("2_emq2c")
id = &"pas"
position = Vector2(0, 18.2)
radius = 3.8
line = "Esquive sans toucher au déplacement : tu sautes en arrière."
hint = "Moins d'endurance, moins loin, et tu ne lui tournes jamais le dos. C'est le pas qui sauve à bout portant."
read_seconds = 5.5
tone = Color(0.42, 0.74, 1, 1)

[sub_resource type="Resource" id="Resource_d736p"]
script = ExtResource("2_emq2c")
id = &"tuer"
position = Vector2(0, 24)
radius = 4.6
line = "Attends le jaune, roule, PUIS frappe."
hint = "Frapper en premier, c'est mourir en premier."
condition = 8
tone = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_2o171"]
script = ExtResource("2_emq2c")
id = &"endurance"
position = Vector2(0, 40)
radius = 4.4
line = "La barre verte est ton endurance."
hint = "À zéro, plus de roulade. C'est comme ça qu'on meurt, pas par manque de vie."
read_seconds = 5.0
tone = Color(0.42, 0.74, 1, 1)

[sub_resource type="Resource" id="Resource_ufhxi"]
script = ExtResource("2_emq2c")
id = &"raccourci"
position = Vector2(19, 117)
radius = 5.0
line = "E sur le levier bleu."
hint = "Le raccourci relie l'arène au feu, définitivement. C'est ta seule victoire acquise."
condition = 9
tone = Color(0.42, 0.74, 1, 1)


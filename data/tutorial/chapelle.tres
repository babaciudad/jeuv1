[ext_resource type="Script" path="res://src/presentation/data/tutorial_sign.gd" id="2_58fhi"]

[sub_resource type="Resource" id="Resource_pb33p"]
script = ExtResource("2_58fhi")
id = &"regarder"
position = Vector2(0, -14)
radius = 4.6
line = "Bouge la souris."
hint = "La caméra ne sert pas à voir : elle décide où tu frappes."
condition = 1

[sub_resource type="Resource" id="Resource_7pvlr"]
script = ExtResource("2_58fhi")
id = &"avancer"
position = Vector2(0, -11.5)
radius = 4.0
line = "ZQSD pour marcher."
hint = "Le déplacement suit la caméra, jamais le personnage."
condition = 2

[sub_resource type="Resource" id="Resource_yxdwd"]
script = ExtResource("2_58fhi")
id = &"rouler"
position = Vector2(1.2, -9.8)
radius = 3.6
line = "Espace pour rouler."
hint = "Tu es invulnérable PENDANT la roulade. Pas avant, pas après."
condition = 3

[sub_resource type="Resource" id="Resource_1tf7f"]
script = ExtResource("2_58fhi")
id = &"frapper"
position = Vector2(1.6, -8)
radius = 3.6
line = "Ce mannequin ne rend pas les coups."
hint = "Clic gauche. C'est le seul adversaire du jeu qui te laissera recommencer."
condition = 4

[sub_resource type="Resource" id="Resource_wln1n"]
script = ExtResource("2_58fhi")
id = &"jaune"
position = Vector2(3.4, -5.4)
line = "Ton arme vire au JAUNE au moment où elle blesse."
hint = "Celle des ennemis aussi. C'est le seul repère de rythme du jeu — apprends-le ici, où ça ne coûte rien."
condition = 6
tone = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_jl0gm"]
script = ExtResource("2_58fhi")
id = &"seconde"
position = Vector2(0.4, -3)
radius = 3.6
line = "Clic droit : ta seconde arme."
hint = "Chaque classe a la sienne. Elle coûte plus d'endurance."
condition = 5

[sub_resource type="Resource" id="Resource_kpi2y"]
script = ExtResource("2_58fhi")
id = &"feu"
position = Vector2(-3, -0.6)
radius = 3.6
line = "Entre dans l'anneau et appuie sur E."
hint = "Le feu te rend ta vie — et replace tous les gobelins. C'est le marché."
condition = 7
tone = Color(0.42, 0.74, 1, 1)

[sub_resource type="Resource" id="Resource_r1pfa"]
script = ExtResource("2_58fhi")
id = &"couloir"
position = Vector2(3, 8.6)
radius = 3.6
line = "Au-delà, plus rien ne pardonne."
hint = "Trois gobelins dans le boyau. Attire-les un par un ; à deux, tu meurs."
read_seconds = 5.0
tone = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_sgfm6"]
script = ExtResource("2_58fhi")
id = &"tuer"
position = Vector2(3, 12.4)
radius = 3.8
line = "Attends le jaune, roule, PUIS frappe."
hint = "Frapper en premier, c'est mourir en premier."
condition = 8
tone = Color(1, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_uepjj"]
script = ExtResource("2_58fhi")
id = &"endurance"
position = Vector2(3, 22)
radius = 3.6
line = "La barre verte est ton endurance."
hint = "À zéro, plus de roulade. C'est comme ça qu'on meurt, pas par manque de vie."
read_seconds = 5.0
tone = Color(0.42, 0.74, 1, 1)

[sub_resource type="Resource" id="Resource_2kj8m"]
script = ExtResource("2_58fhi")
id = &"raccourci"
position = Vector2(-15, 44.5)
radius = 4.5
line = "E sur le levier bleu."
hint = "Le raccourci relie l'arène au feu, définitivement. C'est ta seule victoire acquise."
condition = 9
tone = Color(0.42, 0.74, 1, 1)


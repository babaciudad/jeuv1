; Projet Godot — configuration racine.
; Toute modification passe par ce fichier versionné, jamais par l'éditeur seul :
; les réglages ci-dessous encodent des invariants d'architecture, pas des goûts.

config_version=5

[application]

config/name="souls-like"
config/description="Souls-like coopératif en ligne. Simulation à pas fixe, hôte autoritaire."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[debug]

; Invariant 10 : typage statique partout. Les avertissements de typage sont
; promus en erreurs (valeur 2) pour que tools/verify.ps1 échoue dessus.
gdscript/warnings/enable=true
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/inference_on_variant=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/integer_division=2
gdscript/warnings/return_value_discarded=1
gdscript/warnings/shadowed_variable=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_parameter=1
gdscript/warnings/standalone_expression=2
gdscript/warnings/unreachable_code=2

[physics]

; Invariant 1 : simulation à pas fixe, 60 Hz.
common/physics_ticks_per_second=60
; Un pic de charge ne doit jamais faire rattraper plus de 8 ticks d'un coup :
; au-delà, on préfère prendre du retard visible plutôt que simuler à l'aveugle.
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0
3d/default_gravity=20.0

[rendering]

; Direction artistique PS1/PS2 : le rendu compatibilité suffit et garantit
; le fonctionnement sur les configurations les plus faibles.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
